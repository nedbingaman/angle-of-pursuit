# Giscus comments. Get these from https://giscus.app after enabling
# Discussions on the repo backing this site. Comments stay hidden until
# all four are set. Copy this file to `.env` and fill it in.
#
# These are public values (they ship in the built HTML) — not secrets.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=
