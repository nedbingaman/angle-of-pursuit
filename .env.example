# Build-time public values. Copy to `.env` and also set each as a build
# variable on the Cloudflare Worker. Both ship to the browser — not secrets.

# Cloudflare Turnstile site key for the comment form. Dashboard → Turnstile →
# add a widget for angleofpursuit.com. The form is hidden until this is set.
PUBLIC_TURNSTILE_SITEKEY=

# Cloudflare Web Analytics beacon token (optional). Dashboard → Analytics →
# Web Analytics → add a site → copy the token. Leave blank to skip the beacon.
PUBLIC_CF_BEACON_TOKEN=

# --- Worker secrets — set with `wrangler secret put NAME`, never in a file ---
# TURNSTILE_SECRET          Turnstile secret key (pairs with the site key)
# MODERATION_USER           Basic-auth username for /moderate
# MODERATION_PASS           Basic-auth password for /moderate
# IP_SALT                   random string; salts stored IP hashes
# PREVIEW_TOKEN             unlocks draft URLs at /posts/<slug>/?preview=<token>
#
# --- Worker plain vars (optional) — dashboard → Settings → Variables ---------
# COMMENTS_REQUIRE_APPROVAL "true" holds comments for /moderate; unset = publish now
# NOTIFY_TO                 address that gets a mail on each new comment
# NOTIFY_FROM               from-address for that mail (must be @ angleofpursuit.com)
