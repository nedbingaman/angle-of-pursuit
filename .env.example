# Giscus comments. Copy this file to `.env` and fill it in. Comments stay
# hidden until all four are set. The same four must also be set in the
# Cloudflare Pages project's build variables.
#
# These are public values (they ship in the built HTML) — not secrets.
#
# REPO_ID and CATEGORY_ID come from https://giscus.app (enter the repo), or
# straight from the GitHub API:
#   gh api graphql -f query='{repository(owner:"OWNER",name:"REPO"){id
#     discussionCategories(first:20){nodes{id name}}}}'
# Giscus also requires the giscus GitHub App installed on the repo:
#   https://github.com/apps/giscus
PUBLIC_GISCUS_REPO=owner/repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
