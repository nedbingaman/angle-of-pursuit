# Cusdis comments. Copy this file to `.env` and fill it in. Comments stay
# hidden until PUBLIC_CUSDIS_APP_ID is set. The same value must also be set
# in the Cloudflare Worker's build variables.
#
# This is a public value (it ships in the built HTML) — not a secret.
#
# Get the app id from https://cusdis.com: sign in, create a project for this
# site, copy the "App ID" (a UUID) from the project's settings.
PUBLIC_CUSDIS_APP_ID=

# Only when self-hosting Cusdis. Leave unset to use the hosted service.
# PUBLIC_CUSDIS_HOST=https://cusdis.com
