{
  "name": "angle-of-pursuit",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:worker": "tsc -p worker/tsconfig.json",
    "cf:dev": "astro build && wrangler dev",
    "cf:migrate": "wrangler d1 execute angle-of-pursuit-comments --remote --file=migrations/0001_init.sql",
    "cf:migrate:local": "wrangler d1 execute angle-of-pursuit-comments --local --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.3.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  }
}
