---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Not found — ${SITE_TITLE}`} description="That page doesn’t exist.">
  <article class="page">
    <h1>Where do you think you are going?</h1>
    <p>
      This page has never existed and will never exist. Get on back to the
      <a href="/">Homepage</a>.
    </p>
  </article>
</BaseLayout>
