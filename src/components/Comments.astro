---
// Giscus comments, backed by GitHub Discussions (per spec section 4).
//
// Setup: enable Discussions on the repo, run https://giscus.app against it,
// then copy the values it gives you into .env (see .env.example). Until those
// are set this component renders nothing, so the site is safe to deploy
// before comments are wired up.
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;

const configured = Boolean(repo && repoId && category && categoryId);
---

{configured && (
  <div class="comments">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      crossorigin="anonymous"
      async></script>
  </div>
)}
