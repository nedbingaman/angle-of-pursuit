---
// Native comments. The list and form render here; the browser fetches
// published comments from /api/comments (worker/index.ts, backed by D1) and
// posts new ones there. Comments publish immediately unless the Worker's
// COMMENTS_REQUIRE_APPROVAL is "true"; either way /moderate can delete them.
//
// PUBLIC_TURNSTILE_SITEKEY enables the Turnstile check. Without it the
// section still reads comments but the form is hidden (a post would fail
// verification server-side anyway).
interface Props {
  /** Post slug — the key comments are stored under. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
const MAX_BODY = 4000;
---

<section
  class="comments"
  data-post={id}
  data-pagefind-ignore
  aria-label={`Comments on ${title}`}
>
  <h2>Comments</h2>

  <ol class="comment-list" aria-live="polite"></ol>
  <p class="comment-msg" data-role="list-msg" hidden></p>

  {turnstileSitekey && (
    <form class="comment-form" novalidate>
      <p class="comment-msg" data-role="form-msg" role="status" hidden></p>

      <label>
        <span>Name</span>
        <input type="text" name="author" maxlength="80" required autocomplete="name" />
      </label>

      <label>
        <span>Comment</span>
        <textarea name="body" maxlength={MAX_BODY} rows="5" required></textarea>
        <span class="comment-count" data-role="count" aria-hidden="true">0 / {MAX_BODY}</span>
      </label>

      <div class="comment-hp" aria-hidden="true">
        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div
        class="cf-turnstile"
        data-sitekey={turnstileSitekey}
        data-theme="auto"
        data-appearance="interaction-only"
      ></div>

      <button type="submit">Post comment</button>
      <p class="comment-note">No account needed — your name shows, nothing else.</p>
    </form>
  )}
</section>

{turnstileSitekey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  (() => {
    const MAX_BODY = 4000;
    const section = document.querySelector<HTMLElement>('.comments[data-post]');
    if (!section) return;
    const post = section.dataset.post!;
    const list = section.querySelector<HTMLOListElement>('.comment-list')!;
    const listMsg = section.querySelector<HTMLElement>('[data-role="list-msg"]')!;
    const form = section.querySelector<HTMLFormElement>('.comment-form');

    const fmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    const parseUTC = (s: string) => new Date(s.replace(' ', 'T') + 'Z');

    type Comment = { id: number; author: string; body: string; created_at: string };

    function render(comments: Comment[]) {
      list.replaceChildren();
      for (const c of comments) {
        const li = document.createElement('li');
        li.className = 'comment';

        const meta = document.createElement('div');
        meta.className = 'comment-meta';
        const name = document.createElement('span');
        name.className = 'comment-author';
        name.textContent = c.author;
        const time = document.createElement('time');
        const d = parseUTC(c.created_at);
        time.dateTime = d.toISOString();
        time.textContent = fmt.format(d);
        meta.append(name, document.createTextNode(' · '), time);

        const body = document.createElement('div');
        body.className = 'comment-body';
        body.textContent = c.body; // text only — never innerHTML

        li.append(meta, body);
        list.append(li);
      }
    }

    function setListMsg(text: string) {
      listMsg.textContent = text;
      listMsg.hidden = !text;
    }

    async function load() {
      try {
        const res = await fetch(`/api/comments?post=${encodeURIComponent(post)}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        const { comments } = (await res.json()) as { comments: Comment[] };
        render(comments);
        setListMsg(comments.length ? '' : 'No comments yet. Be the first.');
      } catch {
        setListMsg('Couldn’t load comments.');
      }
    }

    if (form) {
      const authorEl = form.querySelector<HTMLInputElement>('[name="author"]')!;
      const bodyEl = form.querySelector<HTMLTextAreaElement>('[name="body"]')!;
      const countEl = form.querySelector<HTMLElement>('[data-role="count"]')!;
      const msg = form.querySelector<HTMLElement>('[data-role="form-msg"]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

      const updateCount = () => {
        countEl.textContent = `${bodyEl.value.length} / ${MAX_BODY}`;
        countEl.classList.toggle('over', bodyEl.value.length > MAX_BODY);
      };
      bodyEl.addEventListener('input', updateCount);
      updateCount();

      const showMsg = (text: string, isError = false) => {
        msg.hidden = false;
        msg.className = isError ? 'comment-msg comment-msg-error' : 'comment-msg';
        msg.textContent = text;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const author = authorEl.value.trim();
        const body = bodyEl.value.trim();
        if (!author) return showMsg('Add your name.', true);
        if (!body) return showMsg('Write a comment first.', true);
        if (body.length > MAX_BODY) return showMsg('Comment is too long.', true);

        const turnstile = (window as any).turnstile;
        const token = turnstile?.getResponse?.() ?? '';

        showMsg('Posting…');
        button.disabled = true;
        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              post,
              author,
              body,
              website: (form.querySelector<HTMLInputElement>('[name="website"]')!).value,
              turnstileToken: token,
            }),
          });
          const out = (await res.json().catch(() => ({}))) as { error?: string; approved?: boolean };
          if (!res.ok) throw new Error(out.error || 'Something went wrong.');
          form.reset();
          updateCount();
          turnstile?.reset?.();
          if (out.approved) {
            await load();
            showMsg('Posted.');
          } else {
            showMsg('Thanks — your comment is in the queue and will appear once approved.');
          }
        } catch (err) {
          showMsg(err instanceof Error ? err.message : 'Something went wrong.', true);
        } finally {
          button.disabled = false;
        }
      });
    }

    load();
  })();
</script>
