---
// Cusdis comments (https://cusdis.com). Lightweight and privacy-friendly:
// readers leave a name and an optional email, no account or login. New
// comments are held for your approval from the Cusdis dashboard.
//
// Renders nothing until PUBLIC_CUSDIS_APP_ID is set — in `.env` locally and
// in the Cloudflare build environment. PUBLIC_CUSDIS_HOST defaults to the
// hosted service; set it only when self-hosting.
interface Props {
  /**
   * Stable per-post identifier — the post slug. Never change it for a given
   * post or the thread detaches from its existing comments.
   */
  id: string;
  title: string;
}

const { id, title } = Astro.props;

const appId = import.meta.env.PUBLIC_CUSDIS_APP_ID;
const host = import.meta.env.PUBLIC_CUSDIS_HOST ?? 'https://cusdis.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

{appId && (
  <section class="comments">
    <div
      id="cusdis_thread"
      data-host={host}
      data-app-id={appId}
      data-page-id={id}
      data-page-url={pageUrl}
      data-page-title={title}
      data-theme="auto"
    ></div>
    <script is:inline async defer src={`${host}/js/cusdis.es.js`}></script>
  </section>
)}
