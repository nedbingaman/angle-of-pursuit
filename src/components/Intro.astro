---
// Homepage self-description. Text comes from src/content/site/settings.json,
// editable at /admin ("Site text"). Renders nothing if both fields are blank.
import { site } from '../lib/site';
---

{(site.introLede || site.introNote) && (
  <div class="intro">
    {site.introLede && <p class="intro-lede">{site.introLede}</p>}
    {site.introNote && <p>{site.introNote}</p>}
  </div>
)}
