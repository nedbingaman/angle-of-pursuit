{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angle-of-pursuit",
  "compatibility_date": "2026-09-09",

  // The Worker runs before the static-asset / edge-cache lookup for every
  // request (run_worker_first) so dynamic routes can't be shadowed by a
  // cached response; it hands everything else to env.ASSETS.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Comment storage.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "angle-of-pursuit-comments",
      "database_id": "dd32f3d8-b381-4212-8627-3a11a6fa3e81"
    }
  ],

  // E-mail on new comments. Enable Email Routing on the zone and verify a
  // destination address first, then uncomment this line and redeploy, and set
  // the NOTIFY_TO / NOTIFY_FROM Worker vars. notify() no-ops until then.
  // "send_email": [{ "name": "SEND_EMAIL" }],

  "observability": { "enabled": true }
}
