# Cloudflare serves these headers for the static assets. Copied verbatim into
# the build output. https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  # Same-origin except: Turnstile (comment form) and the optional Cloudflare
  # Web Analytics beacon. 'wasm-unsafe-eval' is Pagefind's WASM. The sha256 is
  # the inline theme script in BaseLayout.astro <head> — if that script's text
  # changes, regenerate the hash or the no-flash theme switch will be blocked.
  # If comments or search break, loosen this first.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'sha256-9rzhWkvpgiWeJofO/YMV7dcp95b5yP6ExDrwxycI87M=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; worker-src 'self' blob:

# Fingerprinted build assets never change under a given name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames are fixed (not hashed), so allow revalidation.
/fonts/*
  Cache-Control: public, max-age=604800

# Generated share images are content-stable per URL.
/og/*
  Cache-Control: public, max-age=86400
